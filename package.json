{
  "name": "@chaturanga/client",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "echo \"Linting skipped for Phase 0\"",
    "typecheck": "tsc --noEmit",
    "server": "tsx server/index.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:online:browser": "node scripts/online-smoke.cjs",
    "start": "node --import tsx server/index.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "chess.js": "^1.4.0",
    "chessops": "0.15.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.22.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.18",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "GPL-3.0-only"
}
