# Client: these are public configuration, never OAuth secrets
VITE_GAME_SERVER_URL=http://127.0.0.1:8787
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server: local-only default; production must use supabase
AUTH_MODE=local
HOST=127.0.0.1
PORT=8787
DB_PATH=data/chaturanga.sqlite
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only advertise providers actually enabled in Supabase
AUTH_PROVIDERS=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
