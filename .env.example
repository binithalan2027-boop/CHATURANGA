# Chaturanga server configuration. Copy to .env and edit. Never commit .env.

# --- Mode ---
# local = loopback test identities (development only, refused in production).
# supabase = real accounts via Supabase Auth (required for public use).
AUTH_MODE=local
NODE_ENV=development

# --- Network ---
HOST=127.0.0.1
PORT=8787
# Comma-separated browser origins allowed to call the API.
# Production example: https://chaturanga.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 when running behind the Caddy/nginx reverse proxy (enables
# X-Forwarded-For client IPs for rate limiting).
TRUST_PROXY=0
# Set to 1 when the proxy terminates TLS (adds the HSTS header).
BEHIND_TLS=0

# --- Rate limits ---
# Multiplies every rate limit (HTTP 120/min/IP, WS 30/min/IP, actions
# 240/min/player, signups 15/min). For load testing/capacity tuning only.
# RATE_LIMIT_SCALE=1

# --- Storage ---
DB_PATH=data/chaturanga.sqlite
GAME_RETENTION_DAYS=180
REPORT_RETENTION_DAYS=365

# --- Supabase (AUTH_MODE=supabase only) ---
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable (anon) key - used to validate user tokens.
# SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key - ONLY for auth-identity deletion on account
# deletion. Never expose to the client.
# SUPABASE_SECRET_KEY=
# Comma-separated OAuth providers to offer: google,facebook,discord
# AUTH_PROVIDERS=google
# Public launch checkpoint: must be "approved" after legal/ops review,
# otherwise the server refuses to start in supabase mode.
# PUBLIC_LEGAL_REVIEW=approved

# --- Optional Add-On Integrations ---

# 1. Google Gemini API (AI Chess Coach)
# Explains Stockfish candidate moves in plain English (free tier available).
# Server key:
# GEMINI_API_KEY=
# Client fallback key (if running standalone frontend):
# VITE_GEMINI_API_KEY=
# Get key: https://aistudio.google.com/docs/pricing

# 2. Microsoft Clarity (Heatmaps & Session Recordings)
# Free project ID tracking script (not a secret API key).
# VITE_CLARITY_PROJECT_ID=
# Get project ID: https://clarity.microsoft.com

# 3. Resend (Transactional Email Service)
# Free tier: 100/day, 3,000/month. Optional for account emails.
# RESEND_API_KEY=
# Get key: https://resend.com/docs/knowledge-base/account-quotas-and-limits

# 4. Lichess & Chess.com Public APIs
# Free, read-only, NO API KEYS REQUIRED!
# Lichess: Daily puzzles, Opening master explorer & cloud evaluations.
# Chess.com: Public player profiles and recent game archive import.

# --- Content Security Policy (production static serving) ---
# CSP_REPORT_ONLY=1
# Extra connect-src origins (comma-separated) if needed:
# CSP_CONNECT_SRC=

# --- Static files (optional) ---
# Directory to serve the built client from. Defaults to dist/ when it exists.
# STATIC_DIR=dist

# --- Monetisation (payments OFF) ---
# off (default) = no limits. trial = each player gets FREE_ONLINE_GAMES
# finished online games, then needs an operator grant (scripts/entitlement.ts).
# There is deliberately no payment integration yet; see docs/MONETISATION.md.
# ENTITLEMENTS=off
# FREE_ONLINE_GAMES=3
