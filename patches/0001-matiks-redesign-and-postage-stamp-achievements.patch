+      const data = await serverRes.json(); +      if (data.explanation) { +        return { +          explanation: data.explanation, +          source: data.source || "gemini", +          available: true, +        }; +      } +    } +  } catch { +    // Server not running or endpoint not reachable, try client fallback if client key configured +  } + +  // 2. Direct client fallback if VITE_GEMINI_API_KEY is configured in Vite env +  const clientKey = import.meta.env.VITE_GEMINI_API_KEY; +  if (clientKey) { +    try { +      const prompt = `You are a supportive, insightful chess master coach.  +Explain this chess situation in 1-2 clear, punchy sentences in plain English for a club player.  +No private data, only chess concepts. +Position FEN: ${fen} +${san ? `Move played: ${san}` : ""} +${bestMove ? `Recommended engine move: ${bestMove}` : ""} +${evaluation ? `Stockfish evaluation: ${evaluation}` : ""} +Focus on the practical tactical motive (e.g. pin, fork, outpost, control of file, king safety).`; + +      const geminiRes = await fetch( +        `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${clientKey}`, +        { +          method: "POST", +          headers: { "Content-Type": "application/json" }, +          body: JSON.stringify({ +            contents: [{ parts: [{ text: prompt }] }], +            generationConfig: { +              maxOutputTokens: 120, +              temperature: 0.3, +            }, +          }), +        } +      ); + +      if (geminiRes.ok) { +        const result = await geminiRes.json(); +        const text = +          result.candidates?.[0]?.content?.parts?.[0]?.text?.trim(); +        if (text) { +          return { +            explanation: text, +            source: "gemini", +            available: true, +          }; +        } +      } +    } catch (err) { +      console.warn("Direct Gemini coach query failed:", err); +    } +  } + +  return { +    explanation: +      "AI Coach is waiting for a GEMINI_API_KEY in .env. Engine calculates positions; Gemini explains the master idea in plain English.", +    source: "heuristic", +    available: false, +  }; +} diff --git a/src/services/chessCom.ts b/src/services/chessCom.ts new file mode 100644 index 00000000..d5e51847 --- /dev/null +++ b/src/services/chessCom.ts @@ -0,0 +1,96 @@ +/** + * Chess.com Public API Service + * Free, read-only, no authentication key required. + * https://support.chess.com/en/articles/9650547-what-is-the-pubapi-and-how-do-i-use-it + */ + +export interface ChessComProfile { +  username: string; +  player_id: number; +  title?: string; +  status: string; +  avatar?: string; +  name?: string; +  url: string; +  country?: string; +  joined: number; +  last_online: number; +  followers: number; +} + +export interface ChessComGame { +  url: string; +  pgn: string; +  time_control: string; +  end_time: number; +  rated: boolean; +  white: { +    username: string; +    rating: number; +    result: string; +  }; +  black: { +    username: string; +    rating: number; +    result: string; +  }; +  rules: string; +  time_class: string; +} + +/** + * Fetch a player's public profile from Chess.com + */ +export async function fetchChessComProfile( +  username: string +): Promise<ChessComProfile | null> { +  const cleanUser = username.trim().toLowerCase(); +  if (!cleanUser) return null; + +  try { +    const res = await fetch(`https://api.chess.com/pub/player/${encodeURIComponent(cleanUser)}`, { +      headers: { +        Accept: "application/json", +      }, +    }); +    if (!res.ok) return null; +    return await res.json(); +  } catch (err) { +    console.warn("Chess.com profile fetch failed:", err); +    return null; +  } +} + +/** + * Fetch the latest archive of games for a given Chess.com user + */ +export async function fetchChessComRecentGames( +  username: string +): Promise<ChessComGame[]> { +  const cleanUser = username.trim().toLowerCase(); +  if (!cleanUser) return []; + +  try { +    // 1. Get the list of monthly archives +    const listRes = await fetch( +      `https://api.chess.com/pub/player/${encodeURIComponent(cleanUser)}/games/archives`, +      { headers: { Accept: "application/json" } } +    ); +    if (!listRes.ok) return []; +    const listData = await listRes.json(); +    const archives: string[] = listData.archives || []; +    if (archives.length === 0) return []; + +    // 2. Fetch the latest month archive +    const latestArchiveUrl = archives[archives.length - 1]; +    const gamesRes = await fetch(latestArchiveUrl, { +      headers: { Accept: "application/json" }, +    }); +    if (!gamesRes.ok) return []; +    const gamesData = await gamesRes.json(); +    return (gamesData.games || []).reverse().slice(0, 15); // Return up to 15 most recent +  } catch (err) { +    console.warn("Chess.com games archive fetch failed:", err); +    return []; +  } +} diff --git a/src/services/lichess.ts b/src/services/lichess.ts new file mode 100644 index 00000000..2a4fba5e --- /dev/null +++ b/src/services/lichess.ts @@ -0,0 +1,150 @@ +/** + * Lichess Open API Service + * Free, read-only, no authentication key required. + * https://lichess.org/api + * https://database.lichess.org + */ + +export interface LichessDailyPuzzle { +  id: string; +  rating: number; +  plays: number; +  initialPly: number; +  solution: string[]; +  themes: string[]; +  game: { +    id: string; +    perf: { key: string; name: string }; +    rated: boolean; +    players: Array<{ +      name: string; +      title?: string; +      rating: number; +    }>; +    pgn: string; +  }; +  fen: string; +} + +export interface LichessOpeningMove { +  uci: string; +  san: string; +  averageRating: number; +  white: number; +  draws: number; +  black: number; +  game?: { +    id: string; +    white: { name: string; rating: number }; +    black: { name: string; rating: number }; +    year: number; +    winner?: 'white' | 'black' | null; +  }; +} + +export interface LichessOpeningStats { +  white: number; +  draws: number; +  black: number; +  moves: LichessOpeningMove[]; +  topGames?: Array<{ +    id: string; +    white: { name: string; rating: number }; +    black: { name: string; rating: number }; +    year: number; +    winner?: 'white' | 'black' | null; +  }>; +  opening?: { +    eco: string; +    name: string; +  }; +} + +export interface LichessCloudEval { +  depth: number; +  knodes: number; +  pvs: Array<{ +    moves: string; +    cp?: number; +    mate?: number; +  }>; +} + +/** + * Fetch the Lichess Daily Tactical Puzzle + */ +export async function fetchDailyPuzzle(): Promise<LichessDailyPuzzle | null> { +  try { +    const res = await fetch("https://lichess.org/api/puzzle/daily", { +      headers: { Accept: "application/json" }, +    }); +    if (!res.ok) return null; +    const data = await res.json(); +    return { +      id: data.puzzle.id, +      rating: data.puzzle.rating, +      plays: data.puzzle.plays, +      initialPly: data.puzzle.initialPly, +      solution: data.puzzle.solution, +      themes: data.puzzle.themes, +      game: { +        id: data.game.id, +        perf: data.game.perf, +        rated: data.game.rated, +        players: data.game.players, +        pgn: data.game.pgn, +      }, +      fen: data.game.treeParts?.fen || "", +    }; +  } catch (err) { +    console.warn("Lichess daily puzzle unavailable:", err); +    return null; +  } +} + +/** + * Fetch Lichess Masters / Player Opening Explorer statistics for any FEN position + */ +export async function fetchOpeningExplorer( +  fen: string, +  database: "masters" | "lichess" = "masters" +): Promise<LichessOpeningStats | null> { +  try { +    const baseUrl = +      database === "masters" +        ? "https://explorer.lichess.ovh/masters" +        : "https://explorer.lichess.ovh/lichess"; + +    const url = new URL(baseUrl); +    url.searchParams.set("fen", fen); +    url.searchParams.set("moves", "8"); +    url.searchParams.set("topGames", "4"); + +    const res = await fetch(url.toString(), { +      headers: { Accept: "application/json" }, +    }); +    if (!res.ok) return null; +    return await res.json(); +  } catch (err) { +    console.warn("Lichess opening explorer unavailable:", err); +    return null; +  } +} + +/** + * Fetch Lichess Cloud Evaluation for position if already analyzed by deep engines + */ +export async function fetchCloudEval(fen: string): Promise<LichessCloudEval | null> { +  try { +    const url = new URL("https://lichess.org/api/cloud-eval"); +    url.searchParams.set("fen", fen); + +    const res = await fetch(url.toString(), { +      headers: { Accept: "application/json" }, +    }); +    if (!res.ok) return null; +    return await res.json(); +  } catch (err) { +    return null; +  } +}