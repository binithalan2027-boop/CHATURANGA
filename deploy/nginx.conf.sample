# Alternative to Caddy: nginx + certbot. WebSocket upgrade headers are required.
# Place in /etc/nginx/sites-available/chaturanga, symlink to sites-enabled.
server {
    listen 80;
    server_name chaturanga.example.com; # replace with your domain
    # certbot --nginx manages the 443 server block and redirect after first run.

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
}
